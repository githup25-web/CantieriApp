# ============================================
# CantieriApp Backend (FASE 6) — Configurazione Ambiente
# Copia questo file in `.env` e personalizza i valori
# ============================================

# --- App ---
APP_NAME=CantieriApp Backend
APP_ENVIRONMENT=production

# --- MongoDB ---
MONGO_URI=mongodb://mongodb:27017
DATABASE_NAME=cantieriapp

# --- JWT / Sicurezza ---
JWT_SECRET_KEY=change-this-to-a-strong-secret-key
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
